{
  "services": [{"binding":"YU_ZORA_ERROR_PAGES","service":"yu-zora-main"}],
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "shape-fit-100",
  "compatibility_date": "2026-08-25",
  "compatibility_flags": ["nodejs_compat"],
  "main": "worker/shared-404/index.mjs",
  "assets": {
    "not_found_handling": "none"
  },
  "routes": [
    {
      "pattern": "yu-zora.com/games/shape-fit-100*",
      "zone_name": "yu-zora.com"
    }
  ]
}
